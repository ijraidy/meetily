    "Models are downloaded once from Hugging Face (argmaxinc/whisperkit-coreml) and run entirely on this iPhone. Download on Wi-Fi. Tap an installed model to select it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models are downloaded once from Hugging Face (argmaxinc/whisperkit-coreml) and run entirely on this iPhone. Download on Wi-Fi. Tap an installed model to select it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزّل النماذج مرة واحدة من Hugging Face ‏(argmaxinc/whisperkit-coreml) وتعمل بالكامل على هذا الجهاز. نزّلها عبر Wi-Fi. اضغط على نموذج منزّل لاختياره."
          }
        }
      }
    },
